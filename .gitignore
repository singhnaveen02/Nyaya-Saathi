# Virtual Environment
.venv/
venv/
ENV/
env/

# Environment Variables & Secrets (Never commit secrets)
.env
*.env
.env.*
!.env.example

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Eval outputs (keep folder via .gitkeep)
outputs/*.json
!outputs/.gitkeep

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
