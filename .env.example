# Provider: gemini | groq | ollama | openai_compat | mock
# Leave LLM_PROVIDER empty to auto-pick: Groq if GROQ_API_KEY is set, else Gemini.
LLM_PROVIDER=gemini

# Optional model override (e.g. gemini-3.5-flash, gemini-3.6-flash, llama-3.3-70b-versatile)
LLM_MODEL=gemini-3.5-flash

# Groq (free key: https://console.groq.com/keys)
GROQ_API_KEY=

# Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Ollama (local, free, no key). Install from ollama.com, then: ollama pull qwen2.5:7b
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Any OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
